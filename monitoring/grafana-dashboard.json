{
 "uid": "docscan",
 "title": "DocScan Overview",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "10s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Jobs processed / sec",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (status) (rate(docscan_jobs_processed_total[1m]))",
     "legendFormat": "{{status}}",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Queue depth",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "max(docscan_queue_depth)",
     "legendFormat": "waiting",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "OCR latency p50 / p95",
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum(rate(docscan_ocr_duration_seconds_bucket[1m])) by (le))",
     "legendFormat": "p95",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    },
    {
     "expr": "histogram_quantile(0.5, sum(rate(docscan_ocr_duration_seconds_bucket[1m])) by (le))",
     "legendFormat": "p50",
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Mean OCR confidence",
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "max": 100
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(rate(docscan_ocr_confidence_sum[1m])) / sum(rate(docscan_ocr_confidence_count[1m]))",
     "legendFormat": "confidence",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ]
  }
 ]
}